root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{yml,yaml,json,md,xml,iss}]
indent_size = 2

[*.{ps1,bat}]
end_of_line = crlf

[*.md]
trim_trailing_whitespace = false

[*.{bmp,png,ico,lng}]
charset = unset
end_of_line = unset
insert_final_newline = unset
trim_trailing_whitespace = unset
