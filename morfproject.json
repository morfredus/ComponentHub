{
  "schema_version": 1,
  "project": { "id": "ComponentHub", "type": "application" },
  "packaging": {
    "provider": "project",
    "targets": {
      "linux-amd64-deb":      { "platform": { "os": "linux", "arch": "x86_64" }, "build": { "preset": "linux" },       "package": { "script": "scripts/linux/package-deb.sh", "format": "deb", "architecture": "amd64", "ci": { "workflow": "packages.yml", "artifact": "componenthub-deb-amd64", "file": "componenthub_{version}_amd64.deb" } } },
      "linux-amd64-appimage": { "platform": { "os": "linux", "arch": "x86_64" }, "build": { "preset": "linux" },       "package": { "script": "scripts/linux/package-appimage.sh", "format": "appimage" } },
      "linux-arm64-deb":      { "platform": { "os": "linux", "arch": "arm64" },  "build": { "preset": "linux-arm64" }, "package": { "script": "scripts/linux/package-deb.sh", "format": "deb", "architecture": "arm64", "ci": { "workflow": "packages.yml", "artifact": "componenthub-deb-arm64", "file": "componenthub_{version}_arm64.deb" } } },
      "windows-x86_64-zip":   { "platform": { "os": "windows", "arch": "x86_64" }, "build": { "preset": "mingw" },     "package": { "script": "scripts/windows/package-win.ps1", "format": "zip", "ci": { "workflow": "packages.yml", "artifact": "componenthub-windows", "file": "ComponentHub-{version}-win64.zip" } } },
      "windows-x86_64-installer": { "platform": { "os": "windows", "arch": "x86_64" }, "build": { "preset": "mingw" }, "package": { "script": "scripts/windows/package-win.ps1", "format": "exe", "ci": { "workflow": "packages.yml", "artifact": "componenthub-windows", "file": "ComponentHub-{version}-win64-setup.exe" } } }
    }
  }
}
